load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

[
    swift_binary(
        name = name,
        srcs = [
            "Process.swift",
            "Version.swift",
        ],
        args = [
            "$(rootpath " + tool + ")",
            name,
        ],
        copts = ["-parse-as-library"],
        data = [tool],
    )
    for name, tool in [
        ("version", "@svu//:svu"),
        ("bump", "@svu//:svu"),
        ("pin_actions", "@pinata//:pinata"),
    ]
]

swift_binary(
    name = "prepare",
    srcs = [
        "Prepare.swift",
        "Process.swift",
    ],
    copts = ["-parse-as-library"],
)

genrule(
    name = "dmg",
    srcs = ["//app:KPasskey"],
    outs = [
        "KPasskey-macos-arm64.dmg",
        "KPasskey-macos-arm64.dmg.sha256",
    ],
    cmd = "$(location :prepare) dmg $(location //app:KPasskey) $(@D)/KPasskey-macos-arm64.dmg",
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    tools = [":prepare"],
)

swift_test(
    name = "version_tests",
    size = "small",
    srcs = [
        "Process.swift",
        "VersionTests.swift",
    ],
    data = [
        ":bump",
        ":version",
        "@svu",
    ],
    env = {
        "BUMP": "$(rootpath :bump)",
        "VERSION": "$(rootpath :version)",
        "SVU": "$(rootpath @svu//:svu)",
    },
)

swift_test(
    name = "archive_tests",
    size = "small",
    srcs = [
        "ArchiveTests.swift",
        "Process.swift",
    ],
    data = [
        ":KPasskey-macos-arm64.dmg",
        ":KPasskey-macos-arm64.dmg.sha256",
        ":prepare",
        "//app:KPasskey",
    ],
    env = {
        "APP": "$(rootpath //app:KPasskey)",
        "DMG": "$(rootpath :KPasskey-macos-arm64.dmg)",
        "PREPARE": "$(rootpath :prepare)",
    },
    # hdiutil needs Disk Arbitration; the release workflow runs this explicitly.
    tags = [
        "manual",
        "no-sandbox",
    ],
)
