load("@rules_apple//apple:macos.bzl", "macos_application", "macos_xpc_service")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "notifications",
    hdrs = ["Notifications.h"],
    aspect_hints = [":notifications_interop"],
)

swift_interop_hint(name = "notifications_interop", module_name = "CNotifications")

swift_library(
    name = "main",
    srcs = ["KPasskeyApp.swift", "Preferences.swift", "TicketMonitor.swift", "TicketStatusItem.swift", "WindowVisibility.swift"],
    copts = ["-parse-as-library"],
    deps = [":notifications", "//xpc:client", "//xpc:contract", "//xpc:ticket_cache"],
)

macos_xpc_service(
    name = "worker_service",
    bundle_name = "Worker",
    bundle_id = "org.kpasskey.KPasskey.worker",
    infoplists = ["//xpc:Worker.plist"],
    minimum_os_version = "14.0",
    deps = ["//xpc:worker_main"],
)

macos_application(
    name = "KPasskey",
    bundle_name = "KPasskey",
    bundle_id = "org.kpasskey.KPasskey",
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    xpc_services = [":worker_service"],
    resources = glob(["Resources/*.png"]) + ["//third_party:license_notices"],
    additional_contents = {
        "//passkey:kpasskey": "PlugIns",
        "//xpc:pkinit_plugin": "PlugIns",
    },
    deps = [":main"],
)

swift_test(
    name = "ticket_status_item_tests",
    size = "small",
    srcs = ["TicketStatusItem.swift", "TicketStatusItemTests.swift"],
    deps = ["//xpc:ticket_cache"],
)

swift_test(
    name = "window_visibility_tests",
    size = "small",
    srcs = ["WindowVisibility.swift", "WindowVisibilityTests.swift"],
)

swift_test(
    name = "preferences_tests",
    size = "small",
    srcs = ["Preferences.swift", "PreferencesTests.swift"],
    env = {"KPASSKEY_TEST_CA": "$(rootpath //xpc:testdata/realm-ca.der)"},
    data = ["//xpc:testdata/realm-ca.der"],
    deps = ["//xpc:contract"],
)
