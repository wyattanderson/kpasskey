load("@rules_apple//apple:macos.bzl", "macos_dylib")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "wire",
    module_name = "PasskeyWire",
    srcs = ["Wire.swift"],
    deps = ["//third_party:libfido2_swift", "//third_party:libcbor_swift"],
)

swift_library(
    name = "plugin",
    module_name = "PasskeyPlugin",
    srcs = ["Plugin.swift"],
    deps = [":wire", "//third_party:krb5_swift"],
    alwayslink = True,
)

macos_dylib(
    name = "kpasskey",
    minimum_os_version = "14.0",
    linkopts = ["-install_name", "@rpath/kpasskey.dylib"],
    deps = [":plugin"],
)

swift_test(
    name = "tests",
    size = "small",
    srcs = ["WireTests.swift", "PluginTests.swift"],
    deps = [":plugin", ":wire", "//third_party:krb5_swift", "//third_party:libfido2_swift"],
)
