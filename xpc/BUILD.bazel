load("@rules_apple//apple:macos.bzl", "macos_application", "macos_xpc_service")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")
load("//build:artifact.bzl", "pkinit_artifact")

package(default_visibility = ["//visibility:public"])

# Development opt-in is a build choice, never an environment or XPC message switch.
config_setting(name = "development_peers", define_values = {"kpasskey_development": "true"})

swift_library(
    name = "contract",
    module_name = "KPasskeyContract",
    srcs = ["Contract.swift", "Configuration.swift", "PeerPolicy.swift"],
    defines = select({":development_peers": ["DEVELOPMENT_PEERS"], "//conditions:default": []}),
)

swift_library(
    name = "client",
    module_name = "KPasskeyClient",
    srcs = ["Client.swift"],
    deps = [":contract"],
)

swift_library(
    name = "worker",
    module_name = "KPasskeyWorker",
    srcs = ["Session.swift", "Kerberos.swift", "Passkey.swift", "FIDO.swift"],
    deps = [":contract", "//third_party:krb5_swift", "//third_party:libfido2_swift", "//passkey:wire"],
)

swift_library(
    name = "worker_main",
    srcs = ["WorkerMain.swift"],
    copts = ["-parse-as-library"],
    deps = [":contract", ":worker"],
)

macos_xpc_service(
    name = "worker_service",
    bundle_name = "Worker",
    bundle_id = "org.kpasskey.harness.worker",
    infoplists = ["Worker.plist"],
    minimum_os_version = "14.0",
    deps = [":worker_main"],
)

swift_library(
    name = "harness_main",
    srcs = ["HarnessMain.swift", "PasswordConsole.swift"],
    copts = ["-parse-as-library"],
    deps = [":client", ":contract"],
)

macos_application(
    name = "harness",
    bundle_name = "KPasskeyHarness",
    bundle_id = "org.kpasskey.harness",
    infoplists = ["Host.plist"],
    minimum_os_version = "14.0",
    xpc_services = [":worker_service"],
    additional_contents = {"//passkey:kpasskey": "PlugIns", ":pkinit_plugin": "PlugIns"},
    deps = [":harness_main", "//third_party:krb5"],
)

pkinit_artifact(name = "pkinit_plugin", src = "//third_party:pkinit")

swift_test(
    name = "passkey_tests",
    size = "small",
    srcs = ["PasskeyTests.swift"],
    deps = [":contract", ":worker", "//third_party:krb5_swift", "//third_party:libfido2_swift", "//passkey:wire"],
)

swift_test(
    name = "console_tests",
    size = "small",
    srcs = ["PasswordConsole.swift", "PasswordConsoleTests.swift"],
    deps = [":client", ":contract"],
)

swift_test(
    name = "kerberos_tests",
    size = "small",
    srcs = ["KerberosTests.swift"],
    env = {
        "KRB5_CONFIG": "$(rootpath :Conflicting.conf)",
        "KRB5CCNAME": "FILE:/intentionally/conflicting/cache",
        "KRB5_TRACE": "/intentionally/conflicting/trace",
    },
    data = [":Conflicting.conf"],
    deps = [":contract", ":worker", "//third_party:krb5_swift"],
)

swift_test(
    name = "contract_tests",
    size = "small",
    srcs = ["ContractTests.swift"],
    deps = [":contract", ":worker"],
)
