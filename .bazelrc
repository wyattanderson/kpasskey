common --enable_bzlmod
build --platforms=//build:macos_arm64
build --host_platform=//build:macos_arm64
build --compilation_mode=opt
# Enable modern Swift language/concurrency checking through the selected toolchain.
build --features=swift.enable_v6
# Select full Xcode without changing the machine-wide xcode-select setting.
# build --repo_env=DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# Let Bazel derive action/test DEVELOPER_DIR and SDKROOT from discovered Xcode.
# Explicit action DEVELOPER_DIR makes Bazel's SDK lookup use xcode-select instead.
build --macos_minimum_os=14.0
build --action_env=PATH=/usr/bin:/bin:/usr/sbin:/sbin
build --incompatible_strict_action_env
build --spawn_strategy=sandboxed
# rules_apple marks binary signing no-sandbox; keep compilation sandboxed.
build --strategy=SignBinary=local
build --strategy=ProcessAndSign=local
build --sandbox_default_allow_network=false
test --test_output=errors
# Explicit opt-in for local ad-hoc XPC peers. Omit for release policy.
build:development --define=kpasskey_development=true
