common --enable_bzlmod
build --platforms=//build:macos_arm64
build --host_platform=//build:macos_arm64
build --compilation_mode=opt
# Select full Xcode without changing the machine-wide xcode-select setting.
build --repo_env=DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# Foreign build actions also invoke xcrun/xcode-select directly.
build --action_env=DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
build --macos_minimum_os=14.0
build --action_env=PATH=/usr/bin:/bin:/usr/sbin:/sbin
build --incompatible_strict_action_env
build --spawn_strategy=sandboxed
# rules_apple marks binary signing no-sandbox; keep compilation sandboxed.
build --strategy=SignBinary=local
build --sandbox_default_allow_network=false
test --test_output=errors
