module(name = "kpasskey")

# Register the Apple toolchain ahead of the generic rules_cc toolchain.
bazel_dep(name = "apple_support", version = "2.8.3")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_apple", version = "5.1.0")
bazel_dep(name = "rules_swift", version = "4.1.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_foreign_cc", version = "0.0.0")

# Upstream HEAD resolved 2026-09-05. Intentionally not the stale release.
archive_override(
    module_name = "rules_foreign_cc",
    sha256 = "7f05eb9cc4b1c600c643e69221c88203244ccadc75ae28c4ade960f0f0742f26",
    strip_prefix = "rules_foreign_cc-f68b351c4691e747f889dc5e4c2cac3cd3b66ea2",
    type = "tar.gz",
    urls = ["https://codeload.github.com/bazel-contrib/rules_foreign_cc/tar.gz/f68b351c4691e747f889dc5e4c2cac3cd3b66ea2"],
)

foreign_tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
foreign_tools.explicit()
foreign_tools.make(
    mode = "source",
    version = "4.4.1",
)
foreign_tools.ninja(
    mode = "binary",
    version = "1.13.2",
)
foreign_tools.pkgconfig(mode = "noop")
foreign_tools.autoconf(mode = "noop")
foreign_tools.automake(mode = "noop")
foreign_tools.m4(mode = "noop")
use_repo(foreign_tools, "rules_foreign_cc_toolchains")

register_toolchains("//build:cmake_toolchain", "@rules_foreign_cc_toolchains//:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

