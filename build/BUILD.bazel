load("@rules_foreign_cc//toolchains/native_tools:native_tools_toolchain.bzl", "native_tool_toolchain")

platform(
    name = "macos_arm64",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
)

native_tool_toolchain(
    name = "cmake",
    path = "$(execpath @cmake_src//:CMake.app/Contents/bin/cmake)",
    target = "@cmake_src//:all",
    tools = ["@cmake_src//:CMake.app/Contents/bin/cmake"],
)

toolchain(
    name = "cmake_toolchain",
    toolchain = ":cmake",
    toolchain_type = "@rules_foreign_cc//toolchains:cmake_toolchain",
    exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
)
